SECRET_KEY=change-this-secret-key
COMPANY_NAME=WITTMANN BATTENFELD INDIA PVT. LTD.
APP_NAME=Whittmann AI Interview System

# AI wrapper settings
# local = use built-in scoring/question templates without paid APIs
# openai = use OpenAI when OPENAI_API_KEY is configured
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Admin report access
ADMIN_REPORT_KEY=admin123

# Optional email OTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional SMS OTP settings using Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
