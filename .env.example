SECRET_KEY=change-this-secret-key
COMPANY_NAME=WITTMANN BATTENFELD India Pvt. Ltd.
APP_NAME=Whittmann AI Interview System

# Keep this enabled for camera/microphone access from another LAN system.
# Browser camera APIs are blocked on plain http://192.168.x.x pages.
ENABLE_HTTPS=1
PORT=5000
SSL_CERT_FILE=.certs/lan-server.crt
SSL_KEY_FILE=.certs/lan-server.key

# PostgreSQL database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wittmann_interview_ai

# Candidate marks required for automatic shortlist.
SHORTLIST_MIN_SCORE=70


# Admin report access
ADMIN_REPORT_KEY=admin123

# Optional email settings for interview test links
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional SMS OTP settings using Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
